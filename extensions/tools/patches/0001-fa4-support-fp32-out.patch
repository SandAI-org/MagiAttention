+        self, *, use_block_sparsity: bool, has_page_table: bool
+    ) -> bool:
+        """Whether fp32 O can reuse finished KV pipeline slots instead of a dedicated sO.
+
+        Borrow needs:
+        1. Compatible features (TMA KV; no split-KV / page table / block-sparsity;
+           pack_gqa tile alignment ok).
+        2. One KV stage buffer tiles `head_dim_v` into >= 2 equal column chunks,
+           each a multiple of the 128B swizzle atom.
+        3. Enough KV stages: `q_stage * n_chunks` borrowed slots + 1 free for mainloop.
+        4. Not the uneven KV smem shape (hdim 192/128).
+        """
+        pack_gqa_misaligned = (
+            self.pack_gqa and self.m_block_size % self.qhead_per_kvhead != 0
+        )
+        if (
+            not self.use_tma_KV
+            or self.is_split_kv
+            or use_block_sparsity
+            or has_page_table
+            or pack_gqa_misaligned
+        ):
+            return False
+
+        # Capacity estimate assuming sO is free (only sQ is dedicated).
+        bytes_per_kv_stage = (
+            self.n_block_size
+            * max(self.head_dim_padded, self.head_dim_v_padded)
