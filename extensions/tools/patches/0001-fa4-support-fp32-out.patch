+        swizzle_atom_cols = 128 * 8 // fp32_width  # 128B atom → 32 fp32 elems
+        uses_uneven_kv_smem = (
+            self.head_dim_padded == 192 and self.head_dim_v_padded == 128
+        )
+        if uses_uneven_kv_smem:
