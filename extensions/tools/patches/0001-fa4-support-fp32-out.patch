+    # No dedicated sO: each O chunk (fake_idx = stage * n_chunks + c) aliases one
+    # KV pipeline slot. Fake views place chunk fake_idx at sK_base + fake_idx * panel;
+    # the real slot is the tile's (loads - R + fake_idx)-th KV load (MMA-done by then).
+    # _borrow_rebase maps fake → physical.
+
+    @cute.jit
+    def _borrow_wrap(self, x: Int32) -> Int32:
+        """x % kv_stage for x in [0, 2 * kv_stage)."""
+        return x - self.kv_stage if x >= self.kv_stage else x
+
+    @cute.jit
+    def _borrow_phys0(self, n_block_min: Int32, n_block_max: Int32) -> Int32:
+        """First borrowed KV slot for this tile: (loads - R) % kv_stage.
+        loads = 2 * max(n_blocks, 1) (K then V; masked tiles still issue one pair)."""
+        R = self.q_stage * self.epi_n_chunks
+        loads = 2 * cutlass.max(n_block_max - n_block_min, 1)
+        return self._borrow_wrap(loads % self.kv_stage + self.kv_stage - R)
